# Bu dosyayi .env olarak kopyala ve degerleri doldur.
# .env ASLA git'e commit edilmez (.gitignore'da).

# --- Cloudflare Worker ---
# Kart yonlendirme + panel API adresi
WORKER_URL=https://taplatr.com

# Worker'daki yonetim uclarini koruyan anahtar.
# Cloudflare > Workers > taplink > Settings > Variables > Secret olarak da tanimli olmali.
ADMIN_KEY=buraya_uzun_rastgele_bir_anahtar

# --- Apify (Google yorum cekme) ---
# apify.com > Settings > API & Integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx

# --- Anthropic (yorum analizi) ---
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
